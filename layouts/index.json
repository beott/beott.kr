{{- /* 공개 글과 소개·문의를 일반 빌드와 개발 서버에서 함께 색인합니다. */ -}}
{{- $entries := slice -}}
{{- range site.RegularPages -}}
  {{- $post := and (eq .Section "posts") (ne .Params.hideme true) (ne .Params.hidden true) -}}
  {{- $info := in (slice "/about" "/contact-us") .Path -}}
  {{- $public := and (not .Draft) (not (.PublishDate.After now)) (or .ExpiryDate.IsZero (.ExpiryDate.After now)) -}}
  {{- if and (or $post $info) $public -}}
    {{- /* .Plain은 <br>·문단 경계를 공백 없이 붙이므로 블록 경계를 공백으로 바꾼 뒤 태그를 제거합니다. */ -}}
    {{- $html := .Content | replaceRE `(?i)<br\s*/?>|</(?:p|h[1-6]|li|dt|dd|blockquote|pre|div|figcaption|tr|td|th)>` " " -}}
    {{- $body := $html | plainify | htmlUnescape | replaceRE `\s+` " " | strings.TrimSpace -}}
    {{- $entries = $entries | append (dict
      "title" .Title
      "href" .RelPermalink
      "author" (.Params.author | default "")
      "filmTitle" (.Params.filmtitle | default "")
      "group" (.Params.group | default "")
      "tags" (.Params.tags | default slice)
      "body" $body
    ) -}}
  {{- end -}}
{{- end -}}
{{- $entries | jsonify -}}
