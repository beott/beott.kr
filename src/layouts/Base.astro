---
/** 모든 페이지의 공통 head/header/footer입니다(기존 Hugo `layouts/_default/baseof.html`). */
import SiteSearch from "../components/SiteSearch.astro";
import { site } from "../lib/site.mjs";
import stylesheet from "../../assets/sass/index.scss?url";

interface Props {
  /** 페이지 제목. 홈은 비워 둡니다. */
  title?: string;
  /** OG 이미지로 쓸 썸네일 경로(`/images/...`). 없으면 기본 OG 이미지를 씁니다. */
  thumbnail?: string;
  /** 검색엔진 색인에서 뺄 페이지(예: 404)면 true입니다. */
  noindex?: boolean;
}

const { title = "", thumbnail, noindex = false } = Astro.props;
// 기존 템플릿은 baseURL(끝 `/` 포함) 뒤에 썸네일 경로를 그대로 붙였으므로 같은 주소를 유지합니다.
const ogImage = `${site.baseURL}${thumbnail || "images/og-image.webp"}`;
const documentTitle = title ? `${site.title} | ${title}` : site.title;
---
<!DOCTYPE html>
<html lang={site.languageCode || "en"}>
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
  <meta content="width=device-width, initial-scale=1.0, maximum-scale=5, user-scalable=5" name="viewport">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <meta name="google-site-verification" content="93TE4voJgl9wXWf0k087lUFu5V-2j53L58wT_T_s6MM" />
  <meta name="description" content="당신과 나의 OTT, 웹진 [비옽] 입니다.">
  <link rel="manifest" href="/manifest.json">

  <meta property="og:title" content={title} />
  <meta property="og:description" content="비옽 BEOTT" />
  <meta property="og:image" content={ogImage} />
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:title" content={title} />
  <meta property="twitter:description" content="비옽 BEOTT" />
  <meta property="twitter:image" content={ogImage} />

  <title>{documentTitle}</title>{noindex && <meta name="robots" content="noindex">}

  <link rel="preload" href="/font/NanumSquareNeoTTF-bRg.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href={stylesheet}>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
  {Astro.url.pathname === "/" && <meta name="generator" content={Astro.generator} />}

  <!-- Google tag (gtag.js) -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-E0H5MGHEKM"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag('js', new Date());

    gtag('config', 'G-E0H5MGHEKM');
  </script>
</head>

<body>
  <header>
    <a href={site.baseURL} class="logo">
      <img src="/images/beott-logo-red.webp" alt="Beott">
    </a>
    <nav>
      <a href="/" class="nav-home">Home</a>
      <a href="/about/">About</a>
      <a href="/contact-us/">Contact Us</a>
      <a class="search-launch" href="/search/" data-search-launch>검색<span class="search-shortcut" aria-hidden="true" data-search-shortcut hidden></span></a>
    </nav>
  </header>

  <SiteSearch mode="dialog" />

  <main id="content">
    <slot />
  </main>

  <footer>
    ©️ BEOTT
  </footer>
  <script src="../../assets/js/header.js"></script>
  <script src="../../assets/js/search.js"></script>
  <script is:inline>
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('/js/sw.js')
        .then(registration => {
          console.log('Service Worker registered with scope:', registration.scope);
        })
        .catch(error => {
          console.log('Service Worker registration failed:', error);
        });
    }
  </script>
</body>
</html>
