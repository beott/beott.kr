---
/** mode(dialog|page)에 따라 고유 ID를 가진 검색 대화상자 또는 검색 페이지를 렌더링합니다. */
interface Props {
  mode: "dialog" | "page";
}

const { mode } = Astro.props;
const isDialog = mode === "dialog";
const id = `search-${mode}`;
const Root = isDialog ? "dialog" : "section";
---
<Root
  class={`site-search site-search--${mode}`}
  aria-labelledby={`${id}-title`}
  data-site-search=""
  data-mode={mode}
  data-search-index="/index.json"
  data-search-limit={isDialog ? 8 : 60}
>
  <div class="search-panel">
    <div class="search-heading">
      {isDialog ? (
        <>
          <h2 id={`${id}-title`} class="search-title">글 검색</h2>
          <button class="search-close" type="button" data-search-close>닫기</button>
        </>
      ) : (
        <h1 id={`${id}-title`} class="search-title">글 검색</h1>
      )}
    </div>
    <form class="search-form" role="search" action="/search/" method="get" data-search-form>
      <label class="search-label" for={`${id}-input`}>제목·작품명·작성자·호수·태그·본문 검색</label>
      <div class="search-input-row">
        <input id={`${id}-input`} class="search-input" type="search" name="q" maxlength="200" autocomplete="off" spellcheck="false" enterkeyhint="search" placeholder="예: 킹덤, 공동체" data-search-input>
        <button class="search-submit" type="submit">검색</button>
      </div>
    </form>
    <p class="search-status" role="status" aria-live="polite" data-search-status>검색어를 입력하세요.</p>
    <button class="search-retry" type="button" data-search-retry hidden>다시 불러오기</button>
    <ul class="search-results" aria-label="검색 결과" data-search-results></ul>
    {isDialog ? (
      <>
        <p class="search-hint" aria-hidden="true">↑↓ 결과 이동 · Enter 열기 · Esc 닫기</p>
        <a class="search-all" href="/search/" data-search-all>전체 검색 페이지 열기</a>
      </>
    ) : (
      <noscript><p class="search-noscript">검색은 JavaScript가 켜져 있어야 동작합니다. <a href="/">홈에서 글 둘러보기</a></p></noscript>
    )}
  </div>
</Root>
