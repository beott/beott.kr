---
/** 없는 주소에서 GitHub Pages가 보여 주는 404 페이지(`/404.html`). sitemap·RSS·검색 색인에는 넣지 않습니다. */
import Base from "../layouts/Base.astro";
---
<Base title="페이지를 찾을 수 없습니다" noindex>
  <article>
    <h1 class="post-title">페이지를 찾을 수 없습니다</h1>
    <section class="post-contents">
      <p>주소가 바뀌었거나 없는 페이지입니다.</p>
      <p><a href="/">홈으로 가기</a> · <a href="/search/">글 검색하기</a></p>
    </section>
  </article>
</Base>
