---
/** 랜딩: 히어로 슬라이더와 `site.main` 순서의 그룹별 썸네일 슬라이더(기존 `layouts/_default/index.html`). */
import Base from "../layouts/Base.astro";
import IssueShortcuts from "../components/IssueShortcuts.astro";
import OptimizedImage from "../components/OptimizedImage.astro";
import { getSite } from "../lib/site.mjs";
import { filmLabel, groupRows, heroPosts, issueShortcuts } from "../lib/site-model.mjs";
import { CARD_SIZES, CARD_WIDTHS, HERO_SIZES, HERO_WIDTHS, imageSrcset, localImagePath, optimizedUrl } from "../lib/responsive-images.mjs";

const model = await getSite();
const hero = heroPosts(model);
const rows = groupRows(model);
// 호별 목차 바로가기는 RECOMMEND 줄 바로 아래(없으면 첫 줄 위)에 두고, 각 호의 첫 그룹 줄 id로 이동한다
const shortcuts = issueShortcuts(rows);
const anchorOf = new Map(shortcuts.map((item) => [item.group, item.anchor]));
const shortcutsAfter = rows.findIndex((row) => row.group === "RECOMMEND");
const firstHeroSrc = localImagePath(hero[0]?.params.thumbnail ?? "");
const firstHeroWidths = firstHeroSrc ? HERO_WIDTHS : [];
const preloadImage = firstHeroSrc ? {
  href: optimizedUrl(firstHeroSrc, firstHeroWidths[firstHeroWidths.length - 1] ?? HERO_WIDTHS.at(-1)),
  srcset: imageSrcset(firstHeroSrc, HERO_WIDTHS),
  sizes: HERO_SIZES,
} : undefined;
---

<Base preloadImage={preloadImage}>
  <h1 class="visually-hidden">비옽</h1>
  <div class="hero-overlay swiper">
    <div class="swiper-wrapper">
      {hero.map((post, index) => {
        const meta = [post.params.author, post.params.filmTitle].filter(Boolean);
        return (
          <div class="swiper-slide">
            {/* 배경 이미지 링크는 마우스 클릭용이며, 키보드·스크린리더는 아래 읽기 버튼을 쓴다 */}
            <a href={post.url} class="hero-link" tabindex="-1" aria-hidden="true">
              <div class="hero-slide">
                {post.params.thumbnail && (
                  <OptimizedImage
                    src={post.params.thumbnail}
                    widths={HERO_WIDTHS}
                    sizes={HERO_SIZES}
                    alt=""
                    eager={index === 0}
                    width={1920}
                    height={1080}
                  />
                )}
              </div>
            </a>
            <div class="hero-info">
              {post.params.group && <p class="hero-group">{post.params.group}</p>}
              <h2 class="hero-title">{post.title}</h2>
              {meta.length > 0 && <p class="hero-meta">{meta.join(" · ")}</p>}
              <a href={post.url} class="hero-cta" aria-label={`${post.title} 읽기`}>
                <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="M7 4.5v15l12-7.5z" fill="currentColor"/></svg>
                읽기
              </a>
            </div>
          </div>
        );
      })}
    </div>
  </div>

  <div class="post-by-group">
    {shortcutsAfter < 0 && shortcuts.length > 0 && <IssueShortcuts shortcuts={shortcuts} />}
    {rows.map((row, index) => (
      <>
      <section class="swiper main-swiper" id={anchorOf.get(row.group)}>
        <h2 class="row-header-title">{row.group}</h2>
        <div class="swiper-wrapper">
          {row.pages.map((post) => (
            <div class="swiper-slide">
              <a href={post.url}>
                {post.params.thumbnail && (
                  <div class="post-item-image">
                    <OptimizedImage
                      src={post.params.thumbnail}
                      widths={CARD_WIDTHS}
                      sizes={CARD_SIZES}
                      alt=""
                      width={800}
                      height={450}
                    />
                    <div class="overlay-title">
                      {post.title}
                      {post.params.author && <span class="overlay-meta">{post.params.author}</span>}
                    </div>
                  </div>
                )}
                {filmLabel(post.params) && <p class="post-item-film">{filmLabel(post.params)}</p>}
              </a>
            </div>
          ))}
        </div>
        <div class="swiper-button-prev"></div>
        <div class="swiper-button-next"></div>
      </section>
      {index === shortcutsAfter && shortcuts.length > 0 && <IssueShortcuts shortcuts={shortcuts} />}
      </>
    ))}
  </div>

  <script is:inline src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
  <script is:inline>

  new Swiper('.hero-overlay', {
    grid: {
      rows: 1,
    },
    loop: true,
    centeredSlides: false,
    grabCursor: true,
    effect: 'fade', // fade, mo
    speed: 1_600, // ms
    fadeEffect: { 
      crossFade: true 
    },
    // 움직임 줄이기 설정이면 자동 전환을 끄고, 마우스를 올리면 잠시 멈춘다
    autoplay: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? false : {
        // 제목과 소개를 읽을 시간을 주기 위해 사진만 있을 때보다 길게 둔다
        delay: 6_000, // ms
        pauseOnMouseEnter: true,
    },
  });

  new Swiper('.main-swiper', {
    grid: {
      rows: 1,
    },
    // loop: true,
    centeredSlides: false,
    grabCursor: true,
    // pagination: {
    //   el: ".swiper-pagination",
    //   clickable: true,
    // },
    navigation: {
      nextEl: '.swiper-button-next',
      prevEl: '.swiper-button-prev',
    },
    // 값을 바꾸면 assets/sass/index.scss의 .swiper-slide 초기 폭도 함께 수정 (CLS 방지)
    breakpoints: {
      // when window width is >= 320px
      320: {
        slidesPerView: 2,
        spaceBetween: 5,
      },
      768: {
        slidesPerView: 3,
        spaceBetween: 10,
      },
      1024: {
        slidesPerView: 4,
        spaceBetween: 10,
      },
      1500: {
        slidesPerView: 5,
        spaceBetween: 10,
      },
    },
  });
  </script>
</Base>
